AGENT_PORT=8000
BACKEND_URL=http://backend:8080
LOG_LEVEL=info
JWT_SECRET=phase-0-insecure-default

# Phase 3 — database (direct psycopg2 writes for pgvector)
DATABASE_URL=postgresql://forge:forge@localhost:5433/forge

# ── Embedding provider ────────────────────────────────────────────────────────
# Default provider is Gemini. Supported values: gemini, openai
EMBEDDING_PROVIDER=gemini

# Gemini: models/text-embedding-004 produces 768-dim vectors.
# If you switch to OpenAI (text-embedding-3-small = 1536-dim) you must
# alter the code_chunks.embedding column type and re-index all repositories.
EMBEDDING_MODEL=models/text-embedding-004
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=32

# ── Provider API keys ─────────────────────────────────────────────────────────
# Get your key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ── Chunking ──────────────────────────────────────────────────────────────────
CHUNK_TOKEN_LIMIT=512
