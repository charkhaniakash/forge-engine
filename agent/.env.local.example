AGENT_PORT=8000
BACKEND_URL=http://backend:8080
LOG_LEVEL=info
JWT_SECRET=phase-0-insecure-default

# ── Database (ingestion + retrieval) ──────────────────────────────────────────
DATABASE_URL=postgresql://forge:forge@localhost:5433/forge

# ── Embedding provider ────────────────────────────────────────────────────────
# Supported: ollama (local), gemini (cloud), openai (cloud)
# ollama uses nomic-embed-text (768 dims, no API key needed).
# Pull it first: ollama pull nomic-embed-text
EMBEDDING__PROVIDER=ollama
EMBEDDING__MODEL=nomic-embed-text
EMBEDDING__DIMENSIONS=768
EMBEDDING__BATCH_SIZE=32
# Cloud alternatives (need API keys):
# EMBEDDING__PROVIDER=gemini
# EMBEDDING__MODEL=gemini-embedding-001
# EMBEDDING__DIMENSIONS=3072
# EMBEDDING__PROVIDER=openai
# EMBEDDING__MODEL=text-embedding-3-small
# EMBEDDING__DIMENSIONS=1536

# ── Chat provider (dev fallback only) ─────────────────────────────────────────
# Production chat keys come from the UI (Settings → Models & API keys / BYOK).
# Per-request headers X-Forge-LLM-* override these env defaults when set.
# Leave CHAT__PROVIDER empty to require BYOK; set for local/dev without Settings.
#
# CHAT__PROVIDER=ollama
# CHAT__MODEL=qwen2.5-coder:7b
OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_FORCE_JSON_PROMPT=true
#
# Dev fallback examples (keys via env — never commit real keys):
# CHAT__PROVIDER=openai
# CHAT__MODEL=gpt-4o-mini
# OPENAI_API_KEY=
# CHAT__PROVIDER=gemini
# CHAT__MODEL=gemini-2.5-flash
# GEMINI_API_KEY=
# CHAT__PROVIDER=anthropic
# CHAT__MODEL=claude-3-5-sonnet-20241022
# ANTHROPIC_API_KEY=
# CHAT__PROVIDER=groq
# CHAT__MODEL=llama-3.3-70b-versatile
# GROQ_API_KEY=
# CHAT__PROVIDER=openrouter
# CHAT__MODEL=openai/gpt-4o-mini
# OPENROUTER_API_KEY=
# CHAT__PROVIDER=mistral
# CHAT__MODEL=mistral-medium-latest
# MISTRAL_API_KEY=
# CHAT__PROVIDER=cohere
# CHAT__MODEL=command-r-plus-08-2024
# COHERE_API_KEY=
# CHAT__PROVIDER=tokenrouter
# CHAT__MODEL=moonshotai/kimi-k3-free
# TOKENROUTER_API_KEY=

# ── Retrieval tuning ──────────────────────────────────────────────────────────
RETRIEVAL__CANDIDATE_K=50
RETRIEVAL__RERANK_K=15
RETRIEVAL__FINAL_K=8
RETRIEVAL__MAX_CHUNKS_PER_FILE=3
RETRIEVAL__CONTEXT_TOKEN_BUDGET=4096
RETRIEVAL__HISTORY_TURNS=6

# ── Chunking ──────────────────────────────────────────────────────────────────
CHUNK_TOKEN_LIMIT=512

# ── Provider API keys (embeddings / optional chat fallback only) ──────────────
# Prefer Settings → Models for chat. Set keys here only for local fallback.
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# TOKENROUTER_API_KEY=
# MISTRAL_API_KEY=
# COHERE_API_KEY=
