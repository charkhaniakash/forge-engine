AGENT_PORT=8000
BACKEND_URL=http://backend:8080
LOG_LEVEL=info
JWT_SECRET=phase-0-insecure-default

# ── Database (Phase 3 direct writes + Phase 4 retrieval) ─────────────────────
DATABASE_URL=postgresql://forge:forge@localhost:5433/forge

# ── Embedding provider (Phase 3) ─────────────────────────────────────────────
# Supported: ollama (local), gemini (cloud), openai (cloud)
# ollama uses nomic-embed-text (768 dims, no API key needed).
# Pull it first: ollama pull nomic-embed-text
EMBEDDING__PROVIDER=ollama
EMBEDDING__MODEL=nomic-embed-text
EMBEDDING__DIMENSIONS=768
EMBEDDING__BATCH_SIZE=32
# Cloud alternatives (need API keys):
# EMBEDDING__PROVIDER=gemini
# EMBEDDING__MODEL=gemini-embedding-001
# EMBEDDING__DIMENSIONS=3072
# EMBEDDING__PROVIDER=openai
# EMBEDDING__MODEL=text-embedding-3-small
# EMBEDDING__DIMENSIONS=1536

# ── Chat provider (Phase 4 Q&A) ───────────────────────────────────────────────
# Supported: openai (default), gemini, anthropic, groq, ollama, openrouter
CHAT__PROVIDER=gemini
CHAT__MODEL=gemini-3.1-pro-preview

# CHAT__PROVIDER=openai
# CHAT__MODEL=gpt-4o-mini

# ── Ollama / local Gemma (fully offline, no API key needed) ──────────────────
# qwen2.5-coder:7b is already pulled and running on GPU via Ollama.
# 1. Ensure Ollama is running:  ollama serve
# 2. Verify model is available: ollama list
# 3. These settings point the agent to the local Ollama instance.
#
# CHAT__PROVIDER=ollama
# CHAT__MODEL=qwen2.5-coder:7b
OLLAMA_BASE_URL=http://localhost:11434
#
# qwen2.5-coder:7b supports JSON-mode natively — prompt injection is OFF by default.
# If you see malformed JSON responses, enable the fallback:
# OLLAMA_FORCE_JSON_PROMPT=true

# Groq (hosted, OpenAI-compatible, very fast). Requires GROQ_API_KEY below.
# CHAT__PROVIDER=groq
# CHAT__MODEL=llama-3.3-70b-versatile

# OpenRouter (OpenAI-compatible, supports many models including NVIDIA)
# CHAT__PROVIDER=openrouter
# CHAT__MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# CHAT__MODEL=poolside/laguna-m.1:free

# ── Retrieval tuning (Phase 4) ────────────────────────────────────────────────
# Pipeline: candidate_k → filter → rerank_k → diversity → final_k
RETRIEVAL__CANDIDATE_K=50
RETRIEVAL__RERANK_K=15
RETRIEVAL__FINAL_K=8
RETRIEVAL__MAX_CHUNKS_PER_FILE=3
RETRIEVAL__CONTEXT_TOKEN_BUDGET=4096
RETRIEVAL__HISTORY_TURNS=6

# ── Chunking (Phase 3) ────────────────────────────────────────────────────────
CHUNK_TOKEN_LIMIT=512

# ── Provider API keys ─────────────────────────────────────────────────────────
# Set only the key(s) for the providers you are using.
GEMINI_API_KEY=openai_api_key
# OPENAI_API_KEY=openai_api_key
# GROQ_API_KEY=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   # from https://console.groq.com/keys
# OPENROUTER_API_KEY=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
