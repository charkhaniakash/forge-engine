AGENT_PORT=8000
BACKEND_URL=http://backend:8080
LOG_LEVEL=info
JWT_SECRET=phase-0-insecure-default

# Phase 3 — database (direct psycopg2 writes for pgvector)
DATABASE_URL=postgresql://forge:forge@localhost:5433/forge

# ── Embedding provider ────────────────────────────────────────────────────────
# Supported values: gemini (default), openai
EMBEDDING_PROVIDER=gemini

# Gemini model via google-genai SDK (v1 endpoint).
# gemini-embedding-001 produces 1536-dim vectors and matches the DB column.
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=32

# ── Provider API keys ─────────────────────────────────────────────────────────
# Get your key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# ── Chunking ──────────────────────────────────────────────────────────────────
CHUNK_TOKEN_LIMIT=512
