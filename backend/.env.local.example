BACKEND_PORT=8080
AGENT_URL=http://agent:8000
DATABASE_URL=postgresql://forge:forge@localhost:5433/forge?sslmode=disable
REDIS_URL=redis://localhost:6379/0
LOG_LEVEL=info
JWT_SECRET=phase-0-insecure-default

# GitHub App Integration (Phase 2)
GITHUB_APP_ID=4135365
GITHUB_APP_NAME=ForgeRepoSync-Akash
GITHUB_WEBHOOK_SECRET=forge-engine-super-secret-2025
GITHUB_APP_PRIVATE_KEY_PATH=./secrets/github-private-key.pem
GITHUB_INSTALL_STATE_SECRET=forge-engine-install-state-secret

# Phase 3 — ingestion worker
# Directory where repos are cloned. Defaults to /tmp/forge-clones.
CLONE_BASE_DIR=/tmp/forge-clones
# Number of parallel ingestion workers. Defaults to 2.
WORKER_CONCURRENCY=2
