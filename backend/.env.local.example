BACKEND_PORT=8080
AGENT_URL=http://agent:8000
DATABASE_URL=postgresql://forge:forge@postgres:5432/forge?sslmode=disable
REDIS_URL=redis://redis:6379/0
LOG_LEVEL=info
JWT_SECRET=phase-0-insecure-default

# GitHub App Integration (Phase 2)
# Set these to enable GitHub integration
GITHUB_APP_ID=4135365
GITHUB_APP_NAME=forge-engine
GITHUB_APP_NAME=ForgeRepoSync-Akash
GITHUB_WEBHOOK_SECRET=forge-engine-super-secret-2025
GITHUB_APP_PRIVATE_KEY_PATH=/app/secrets/github-private-key.pem
# State secret for GitHub install flow (JWT signing)
# Falls back to JWT_SECRET if not set
GITHUB_INSTALL_STATE_SECRET=forge-engine-install-state-secret